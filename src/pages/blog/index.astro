---
import { getCollection } from 'astro:content';
import Ambient from '../../components/Ambient.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 同一天发的文章要有第二排序键，否则首页那几格被谁占着取决于文件名字母序
const posts = (await getCollection('blog')).sort(
	(a, b) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Ambient />
		<Header />
		<main>
			<header class="head">
				<h1 class="heading" data-mask data-reveal>文章</h1>
				<p class="count" data-reveal style="--rd:180ms">
					共 <span>{posts.length}</span> 篇 · 记笔记、项目和一时想到的东西
				</p>
			</header>
			<ul data-stagger data-stagger-step="90">
				{
					posts.map((post) => (
						<li data-reveal data-spotlight>
							<article class="row">
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<FormattedDate date={post.data.pubDate} />
								<p>{post.data.description}</p>
							</article>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 900px;
		max-width: calc(100% - 2.5em);
		margin: auto;
		padding: 0 1.25em;
	}
	.head {
		padding: clamp(3.5rem, 9vh, 6rem) 0 2.2rem;
	}
	.heading {
		margin: 0;
		font-family: var(--font-serif-cjk);
		font-size: clamp(2.4rem, 6vw, 3.6rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}
	.count {
		margin: 0.9rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		color: rgba(var(--gray), 85%);
	}
	.count span {
		color: var(--accent);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}
	li {
		border-bottom: 1px solid var(--rule);
	}
	.row {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'title date'
			'desc desc';
		gap: 0 1.5rem;
		align-items: baseline;
		padding: 1.5rem 1rem;
		transition: padding 0.45s var(--e-expo);
	}
	.row:hover {
		padding-left: 1.4rem;
	}
	h2 {
		grid-area: title;
		margin: 0;
		font-size: 1.28rem;
	}
	h2 a {
		color: rgb(var(--black));
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-size: 0% 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.5s var(--e-expo);
	}
	h2 a:hover {
		background-size: 100% 1px;
		color: rgb(var(--black));
	}
	.row :global(time) {
		grid-area: date;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.04em;
		color: rgba(var(--gray), 80%);
		white-space: nowrap;
	}
	p {
		grid-area: desc;
		max-width: 62ch;
		margin: 0.45rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.96rem;
		line-height: 1.8;
	}
	@media (max-width: 720px) {
		.row {
			grid-template-columns: 1fr;
			grid-template-areas:
				'date'
				'title'
				'desc';
			gap: 0;
			padding: 1.3rem 0.6rem;
		}
		.row :global(time) {
			margin-bottom: 0.3rem;
		}
	}
</style>

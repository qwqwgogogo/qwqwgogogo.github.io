---
import { getCollection } from 'astro:content';
import Ambient from '../components/Ambient.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type Project = {
	name: string;
	desc: string;
	tags: string;
	year: string;
	url?: string;
	secondary?: { label: string; url: string };
};

const projects: Project[] = [
	{
		// 源码仓库已转私有，只挂公开的演示站；url 留空则不渲染「仓库」和标题链接
		name: '小豚 · 武汉 SPU 城市 AI 接待员',
		desc: '纯静态、离线可用、句句有出处的城市 AI 接待员。SAIG 数命 SPU 国际 AI 大赛参赛作品。',
		tags: 'TypeScript · 静态站',
		year: '2026',
		secondary: { label: '在线演示', url: 'https://xiaotun-wuhan-fy73vgwpmp3.qoder.zone' },
	},
	{
		name: 'Ollama Model Manager',
		desc: 'Windows 桌面应用：实时显示 GPU / CPU 显存占用，加载模型前先预估资源影响，并按硬件推荐最合适的模型。已打 Windows 可执行文件发 Release。',
		tags: 'Python · 桌面应用',
		year: '2026',
		url: 'https://github.com/qwqwgogogo/Ollama-Model-Manager',
		secondary: { label: '下载 exe', url: 'https://github.com/qwqwgogogo/Ollama-Model-Manager/releases/latest' },
	},
	{
		name: 'SWEF-AT',
		desc: '稳定性加权的集成特征过滤方法：融合六个异构过滤器打分，再用自适应拐点自动确定保留特征数。论文源码与复现脚本。',
		tags: 'Python · 研究复现',
		year: '2025',
		url: 'https://github.com/qwqwgogogo/SWEF-AT',
	},
];

const handle = 'qwqwgogogo';
const shortName = (p: Project) => p.name.split(' · ')[0];
const primaryUrl = (p: Project) => p.secondary?.url ?? p.url;
const titleUrl = (p: Project) => p.url ?? p.secondary?.url;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Ambient />
		<Header />
		<main>
			<section class="hero" data-glow>
				<p class="who" data-reveal style="--rd:100ms">
					<span data-scramble="700">@{handle}</span>
					<span class="sep" aria-hidden="true">—</span>
					<span>个人站</span>
				</p>
				<h1 class="stmt" data-mask data-reveal style="--rd:180ms">
					{SITE_DESCRIPTION}
				</h1>
				<p class="now" data-reveal style="--rd:420ms">
					手上三个项目：
					{
						projects.map((p, i) => (
							<>
								{i > 0 && (i === projects.length - 1 ? ' 和 ' : '、')}
								{primaryUrl(p) ? (
									<a class="sweep" href={primaryUrl(p)}>{shortName(p)}</a>
								) : (
									<span>{shortName(p)}</span>
								)}
							</>
						))
					}；不定期写的笔记都在<a
						class="sweep"
						href="/blog/">文章</a>里。
				</p>
				<p class="meta" data-reveal style="--rd:560ms">
					{projects.length} 个作品 · {posts.length} 篇文章 · 最近更新
					{' '}
					<FormattedDate date={posts[0]?.data.pubDate ?? new Date()} />
				</p>
			</section>

			<section class="sec">
				<h2 class="sec-t"><span data-mask data-reveal>作品</span><i class="mono">Selected work</i></h2>
				<ol class="rows">
					{
						projects.map((p, i) => (
							<li data-reveal data-spotlight>
								<span class="n">{String(i + 1).padStart(2, '0')}</span>
								<div class="body">
									<h3>
										{titleUrl(p) ? <a href={titleUrl(p)}>{p.name}</a> : <span>{p.name}</span>}
									</h3>
									<p>{p.desc}</p>
									<span class="tags">{p.tags}</span>
								</div>
								<div class="side">
									{p.secondary && <a href={p.secondary.url}>{p.secondary.label}</a>}
									{p.url && <a href={p.url}>仓库</a>}
									<span class="yr">{p.year}</span>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="sec">
				<h2 class="sec-t"><span data-mask data-reveal>文章</span><i class="mono">Latest notes</i></h2>
				<ul class="notes">
					{
						posts.slice(0, 4).map((post) => (
							<li data-reveal data-spotlight>
								<a href={`/blog/${post.id}/`}>
									<span class="t">{post.data.title}</span>
									<span class="d">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="more">
					<a class="sweep" href="/blog/">所有文章 →</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 1040px;
		max-width: calc(100% - 2.5em);
		margin: auto;
		padding: 0 1.25em;
	}

	/* ---------- hero：一句话当主视觉，链接嵌在句子里 ---------- */
	.hero {
		position: relative;
		padding: clamp(6rem, 17vh, 11rem) 0 clamp(3.5rem, 8vh, 5rem);
		overflow: clip;
	}
	.who {
		display: flex;
		align-items: center;
		gap: 0.55em;
		margin: 0 0 clamp(1.6rem, 4vh, 2.6rem);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		color: var(--accent);
	}
	.who .sep,
	.who span:last-child {
		color: rgb(var(--gray));
		letter-spacing: 0.04em;
	}
	.stmt {
		margin: 0;
		max-width: 15em;
		font-family: var(--font-serif-cjk);
		font-size: clamp(2.3rem, 6.4vw, 4.4rem);
		font-weight: 700;
		line-height: 1.26;
		letter-spacing: -0.012em;
		color: rgb(var(--black));
	}
	.now {
		max-width: 46ch;
		margin: clamp(1.8rem, 4vh, 2.6rem) 0 0;
		font-size: 1.08rem;
		line-height: 1.85;
		color: rgb(var(--gray));
	}
	.now a {
		color: rgb(var(--black));
	}
	.now a:hover {
		color: var(--accent-dark);
	}
	.meta {
		margin: 2.2rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.05em;
		color: rgba(var(--gray), 85%);
	}
	.meta :global(time) {
		color: rgb(var(--black));
	}

	/* ---------- 区块 ---------- */
	.sec {
		padding: clamp(2.6rem, 6vh, 3.6rem) 0;
		border-top: 1px solid var(--rule);
	}
	.sec-t {
		display: flex;
		align-items: baseline;
		gap: 1em;
		margin: 0 0 1.6rem;
		font-family: var(--font-serif-cjk);
		font-size: 1.35rem;
		font-weight: 700;
	}
	.sec-t .mono {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-style: normal;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(var(--gray), 75%);
	}

	/* ---------- 作品行 ---------- */
	.rows,
	.notes {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows li {
		display: grid;
		grid-template-columns: 46px minmax(0, 1fr) 150px;
		gap: 1.4rem;
		align-items: start;
		padding: 1.5rem 0.9rem 1.5rem 0;
		border-top: 1px solid var(--rule);
	}
	.rows li:first-child {
		border-top: none;
	}
	.rows .n {
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 400;
		line-height: 1.1;
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}
	.rows h3 {
		margin: 0;
		font-size: 1.3rem;
		line-height: 1.4;
	}
	.rows h3 a {
		color: rgb(var(--black));
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-size: 0% 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.5s var(--e-expo);
	}
	.rows h3 a:hover {
		background-size: 100% 1px;
	}
	.rows p {
		max-width: 62ch;
		margin: 0.5rem 0 0;
		font-size: 0.98rem;
		line-height: 1.8;
		color: rgb(var(--gray));
	}
	.rows .tags {
		display: block;
		margin-top: 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: rgba(var(--gray), 72%);
	}
	.rows .side {
		display: grid;
		gap: 0.45rem;
		justify-items: end;
		padding-top: 0.2rem;
	}
	.rows .side a {
		font-size: 0.86rem;
		color: rgb(var(--gray));
		text-decoration: none;
		white-space: nowrap;
	}
	.rows .side a::after {
		content: ' →';
		color: rgba(var(--gray), 60%);
		transition: color 0.3s var(--e-out);
	}
	.rows .side a:hover {
		color: var(--accent-dark);
	}
	.rows .side a:hover::after {
		color: var(--accent);
	}
	.rows .yr {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgba(var(--gray), 60%);
	}

	/* ---------- 文章行 ---------- */
	.notes li {
		border-top: 1px solid var(--rule);
	}
	.notes li:first-child {
		border-top: none;
	}
	.notes a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5em;
		padding: 1rem 0.9rem;
		font-size: 1.05rem;
		color: rgb(var(--black));
		text-decoration: none;
		transition: padding-left 0.4s var(--e-expo);
	}
	.notes a:hover {
		padding-left: 1.3rem;
		color: var(--accent-dark);
	}
	.notes .d {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: rgba(var(--gray), 80%);
		white-space: nowrap;
	}
	.more {
		margin: 1.4rem 0 0;
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.rows li {
			grid-template-columns: 34px minmax(0, 1fr);
		}
		.rows .side {
			grid-column: 2;
			justify-items: start;
			grid-auto-flow: column;
			gap: 1.1rem;
			align-items: baseline;
		}
		.rows .yr {
			display: none;
		}
	}
</style>

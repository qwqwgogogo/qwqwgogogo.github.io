---
import { CONTACT_MAIL } from '../consts';

const today = new Date();
---

<footer data-reveal>
	<div class="inner">
		<p class="sign">&copy; {today.getFullYear()} qwqw</p>
		<div class="links">
			<a href={`mailto:${CONTACT_MAIL}`}>{CONTACT_MAIL}</a>
			<a href="/rss.xml">RSS</a>
			<a href="https://github.com/qwqwgogogo">GitHub</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 5em 1em 6em;
		color: rgb(var(--gray));
	}
	.inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		width: 1040px;
		max-width: 100%;
		margin: auto;
		padding-top: 1.4rem;
		border-top: 1px solid var(--rule);
	}
	.sign {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
	}
	.links {
		display: flex;
		gap: 1.4rem;
	}
	.links a {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		color: rgba(var(--gray), 88%);
		text-decoration: none;
		transition: color 0.3s var(--e-out);
	}
	.links a:hover {
		color: var(--accent);
	}
</style>

---
/**
 * 图谱的舞台：3D 画布 + 构建时算好的平面降级版 + 右边的说明面板 + 左边的按钮栏。
 * /knowledge/ 和 /knowledge/408/ 共用这一份，喂进去的图和按钮栏配置不同；
 * 每个按钮栏是一段 { 标题, 节点 }，第一栏用 h2，其余用 h3；带 pending 的那格渲染成虚线链接
 * （图里没有它的点，不能给一个点了没反应的按钮）。
 */
import type { Graph, GraphNode } from '../scripts/knowledge-gl';
import { glossHref, kindLabel, metaFor, noGlossLine } from '../scripts/kb-copy';

type Section = { title: string; href?: string; items: (GraphNode | { pending: string })[] };

const {
	graph,
	hubCount = 14,
	sections = [],
}: { graph: Graph; hubCount?: number; sections?: Section[] } = Astro.props;
const scope = graph.scope;

const titleOf = new Map<string, string>(
	[...graph.posts, ...graph.notes].map((d) => [d.slug, d.title] as [string, string]),
);
const subjectOf = new Map(graph.subjects.map((s) => [s.key, s.name]));
const degree = new Map<number, number>();
graph.edges.forEach((e) => {
	degree.set(e.a, (degree.get(e.a) ?? 0) + e.weight);
	degree.set(e.b, (degree.get(e.b) ?? 0) + e.weight);
});
const deg = (n: GraphNode) => degree.get(n.id) ?? 0;
const neighbors = (id: number) =>
	[...new Set(graph.edges.filter((e) => e.a === id || e.b === id).map((e) => (e.a === id ? e.b : e.a)))];

// 降级用的平面图：构建时把同一批球面坐标做一次固定角度的正交投影，
// 所以没有 WebGL 的机器看到的结构和能跑的机器是同一张图，不是另画一张。
const YAW = -0.55;
const PITCH = 0.34;
const project = (n: GraphNode) => {
	const cy = Math.cos(YAW);
	const sy = Math.sin(YAW);
	const cp = Math.cos(PITCH);
	const sp = Math.sin(PITCH);
	const x1 = n.x * cy + n.z * sy;
	const z1 = -n.x * sy + n.z * cy;
	const y2 = n.y * cp - z1 * sp;
	return { sx: +(x1 + 130).toFixed(1), sy: +(-y2 + 130).toFixed(1) };
};
const pts = new Map(graph.nodes.map((n) => [n.id, project(n)]));
const W = 260;
const hubs = [...graph.nodes]
	.sort((a, b) => deg(b) - deg(a))
	.slice(0, hubCount)
	.map((n) => n.id);
const selected = graph.nodes.reduce((a, b) => (deg(b) > deg(a) ? b : a));

const hrefOf = (slug: string) => (graph.notes.some((d) => d.slug === slug) ? `/notes/${slug}/` : `/blog/${slug}/`);
const metaOf = (n: GraphNode) =>
	metaFor(n, scope, neighbors(n.id).length, n.subject ? subjectOf.get(n.subject) : undefined);
const isNode = (x: GraphNode | { pending: string }): x is GraphNode => 'id' in x;

// 平面版的画法：边和点各汇成几条 path，而不是一个点一个元素。
// 825 个点加 2621 条边如果各给一个标签，这张页的 HTML 是 601KB、三千多个 DOM 节点，
// 手机上进这一页光解析就够卡一下；汇成 path 之后同样的图剩下几万字符。
const rOf = (n: GraphNode) => 1.6 + Math.min(deg(n), 14) * 0.22;
const at = (id: number) => pts.get(id)!;
const edgeD = (list: typeof graph.edges) =>
	list.map((e) => {
		const a = at(e.a);
		const b = at(e.b);
		return `M${a.sx} ${a.sy}L${b.sx} ${b.sy}`;
	}).join('');
// 小圆点画成「零长度的一段 + 圆头」，一个点只花十几个字符，粗细就是点直径。
// 考点按连得多不多分三档；科目、笔记、项目只有百来个点，还是各画各的圆，颜色才对得上图例。
const conceptDot = (pick: (d: number) => boolean) =>
	graph.nodes
		.filter((n) => n.kind === 'concept' && pick(rOf(n)))
		.map((n) => {
			const p = at(n.id);
			return `M${p.sx} ${p.sy}h.01`;
		})
		.join('');
const otherNodes = graph.nodes.filter((n) => n.kind !== 'concept');
const hubSet = new Set(hubs);
---

<div class="stage" data-stage>
	<svg
		class="flat"
		viewBox={`0 0 ${W} ${W}`}
		preserveAspectRatio="xMidYMid meet"
		role="group"
		aria-label="概念图的平面版本，连得最多的词可以选"
	>
		<title>概念图的平面版本（按构建时算好的坐标绘制）</title>
		<path class="edge" d={edgeD(graph.edges.filter((e) => e.weight < 2))} />
		<path class="edge strong" d={edgeD(graph.edges.filter((e) => e.weight >= 2))} />
		<path class="dots" d={conceptDot((d) => d < 2.6)} stroke-width="4" />
		<path class="dots" d={conceptDot((d) => d >= 2.6 && d < 3.9)} stroke-width="6.4" />
		<path class="dots" d={conceptDot((d) => d >= 3.9)} stroke-width="9.4" />
		{
			otherNodes.map((n) => {
				const p = at(n.id);
				return <circle class={`node ${n.kind}`} cx={p.sx} cy={p.sy} r={rOf(n).toFixed(2)} />;
			})
		}
		{
			graph.nodes
				.filter((n) => hubSet.has(n.id))
				.map((n) => {
					const p = pts.get(n.id)!;
					return (
						<g
							data-node-id={n.id}
							class="pick"
							role="button"
							tabindex="0"
							aria-label={`${n.label}，${kindLabel(n.kind, scope)}`}
						>
							<circle class="hit" cx={p.sx} cy={p.sy} r={(rOf(n) + 4).toFixed(1)} />
							<text class="tag" x={p.sx + 4} y={p.sy - 3}>{n.label}</text>
						</g>
					);
				})
		}
	</svg>
	<p class="hint">
		<span class="pointer">拖动旋转 · 滚轮缩放 · </span><span class="touch">单指横拖旋转 · 双指缩放 · </span>点一个词看它连着什么
	</p>
</div>

<div class="legend" data-reveal>
	{
		scope === 'exam' ? (
			<>
				<span>
					<i class="s" />
					408 科目
				</span>
				<span>
					<i class="n" />
					学习笔记
				</span>
				<span>
					<i />
					考点
				</span>
			</>
		) : (
			<>
				<span>
					<i />
					文章里的概念
				</span>
				<span>
					<i class="p" />
					项目
				</span>
			</>
		)
	}
	<span>点越大 = 连得越多 · 线越粗 = 在同几篇里反复共现</span>
</div>

<div class="split">
	<div class="column">
		{
			sections.map((s, i) => (
				<>
							{i === 0 ? <h2>{s.title}</h2> : <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3>}
							<ul class="chips" data-chips>
								{s.items.map((item) => (
									<li>
										{isNode(item) ? (
											<button type="button" data-node-id={item.id} aria-current={String(item.id === selected.id)}>
												{item.label}
											</button>
										) : (
											<a class="empty-chip" href="/notes/">
												{item.pending}（还没写）
											</a>
										)}
									</li>
								))}
							</ul>
						</>
			))
		}
		<slot />
	</div>

	<aside class="detail" data-detail aria-live="polite">
		<p class="kind">{kindLabel(selected.kind, scope)}</p>
		<p class="name">
			{selected.kind === 'note' ? titleOf.get(selected.notes[0] ?? '') ?? selected.label : selected.label}
		</p>
		<p class="meta">{metaOf(selected)}</p>
		{selected.kind === 'note' && selected.desc && <p class="gloss">{selected.desc}</p>}
		{
			selected.gloss ? (
				<p class="gloss">
					{selected.gloss.text}
					<span class="from">
						出自 <a href={glossHref(selected.gloss)}>{selected.gloss.title}</a>
					</span>
				</p>
			) : (
				noGlossLine(selected) && <p class="gloss">{noGlossLine(selected)}</p>
			)
		}
		{
			selected.posts.length + selected.notes.length > 0 && (
				<ul>
					{[...selected.posts, ...selected.notes].map((slug) => (
						<li>
							<a href={hrefOf(slug)}>{titleOf.get(slug) ?? slug}</a>
						</li>
					))}
				</ul>
			)
		}
		{selected.kind === 'subject' && <a href="/notes/">学习笔记页 ↗</a>}
		{
			selected.kind === 'project' && selected.url && (
				<a href={selected.url} target="_blank" rel="noreferrer">
					仓库 / 演示 ↗
				</a>
			)
		}
	</aside>
</div>

<style>
	.stage {
		position: relative;
		height: clamp(360px, 58vh, 620px);
		margin: 1.6em 0 0;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: radial-gradient(120% 90% at 50% 0%, #fffdf8 0%, var(--bg) 62%, var(--bg-deep) 100%);
		overflow: hidden;
	}
	.stage :global(.kb-gl) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		/* pan-y：手机上竖着划还是滚页面，横着划才转图，不然整页划不动 */
		touch-action: pan-y;
		cursor: grab;
	}
	.stage :global(.kb-gl:active) {
		cursor: grabbing;
	}
	.flat {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	/* WebGL 起来之后才把平面图收起来，两条路不会同时出现在无障碍树里 */
	.stage.is-3d .flat {
		display: none;
	}
	.flat .edge {
		fill: none;
		stroke: rgba(23, 22, 26, 0.16);
	}
	.flat .edge.strong {
		stroke: rgba(23, 22, 26, 0.4);
	}
	/* 汇成一条 path 的考点：靠圆头的零长度线段当点，粗细就是直径 */
	.flat .dots {
		fill: none;
		stroke: rgb(var(--black));
		stroke-linecap: round;
		opacity: 0.62;
	}
	.flat .node {
		fill: rgb(var(--black));
	}
	.flat .node.project {
		fill: var(--accent);
	}
	.flat .node.note {
		fill: #2e6b63;
	}
	.flat .node.subject {
		fill: #7a6a2f;
	}
	.flat .tag {
		font-family: var(--font-mono);
		font-size: 7px;
		fill: rgba(23, 22, 26, 0.72);
	}
	/* 降级版也得能用键盘走：可点的那十几个词各盖一个透明的命中圆 */
	.flat .pick {
		cursor: pointer;
		outline: none;
	}
	.flat .pick .hit {
		fill: transparent;
	}
	.flat .pick:hover .hit {
		fill: rgba(191, 63, 38, 0.12);
	}
	.flat .pick:focus-visible .hit {
		stroke: var(--accent);
		stroke-width: 1.6;
		fill: rgba(191, 63, 38, 0.12);
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem;
		align-items: center;
		margin: 0.9em 0 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.legend i {
		display: inline-block;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		margin-right: 0.45em;
		background: rgb(var(--black));
		vertical-align: middle;
	}
	.legend i.p {
		background: var(--accent);
	}
	.legend i.n {
		background: #2e6b63;
	}
	.legend i.s {
		background: #7a6a2f;
	}
	.hint {
		position: absolute;
		right: 14px;
		bottom: 12px;
		padding: 0.25em 0.7em;
		border-radius: 999px;
		background: rgba(246, 243, 236, 0.86);
		font-size: 0.75rem;
		color: rgb(var(--gray));
		pointer-events: none;
	}
	.hint .touch {
		display: none;
	}
	@media (hover: none), (pointer: coarse) {
		.hint .pointer {
			display: none;
		}
		.hint .touch {
			display: inline;
		}
		/*
		 * 上一版给面板里所有 a 加 padding-block: 0.9rem：命中框 51px，
		 * 而这份列表的行距只有 28px——每条会把上一条的文字整个盖住，
		 * 实测点在「一个 C 程序在内存…」这一行上，打开的却是下一条。
		 * 改成让链接变成块，padding 参与排版，命中框与版式一一对应；
		 * 下划线换回 text-decoration，否则通栏变成一条整行宽的横线。
		 */
		.detail :global(ul:not(.chips) > li > a) {
			display: block;
			min-height: 44px;
			padding-block: 0.5rem;
			border-bottom: 0;
			text-decoration: underline;
			text-decoration-color: rgba(191, 63, 38, 0.45);
			text-underline-offset: 3px;
		}
		/* 说明段是正文行内链接，行高只有 20px，padding 不能超过行距，否则又变成互相抢命中区 */
		.detail :global(.gloss a) {
			padding-block: 0.2rem;
		}
	}
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 1.6rem;
		margin-top: 2.2em;
		align-items: start;
	}
	@media (max-width: 860px) {
		.split {
			grid-template-columns: 1fr;
		}
		/* 单列时说明面板原本排在考点列表后面，而 408 那张图的列表有一万多像素高——
		 * 点完一个考点，解释在十几屏之外，等于没有反馈。让它先出现。 */
		.detail {
			order: -1;
		}
	}
	.detail {
		position: sticky;
		top: 92px;
		padding: 1.2em 1.3em;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: #fffdf8;
		font-size: 0.95rem;
	}
	/*
	 * 桌面那套 sticky 在窄屏必须关掉，而且要写在 sticky 那条之后——同一个特异度，
	 * 谁在后面谁说了算，放前面会被顶掉（第一版就踩了这个坑，线上照旧盖住列表）。
	 * 一列时面板压在列表上方，吸住不动等于用一块不透明的板子盖住胶囊列表：
	 * 实测 850 个胶囊的中点被 aside.detail / p.name 抢走。
	 * 反馈改由脚本负责（选中后把面板拉回视口，见 knowledge.ts 的 select）。
	 */
	@media (max-width: 860px) {
		.detail {
			position: static;
			scroll-margin-top: 120px;
		}
	}
	/* 说明面板每次选中都由脚本重建，拿不到 scoped 样式的作用域属性，所以写成子选择器 */
	.detail :global(.kind) {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.detail :global(.name) {
		margin: 0.2em 0 0.5em;
		font-family: var(--font-serif-cjk);
		font-size: 1.5rem;
		line-height: 1.2;
		word-break: break-word;
	}
	.detail :global(.meta) {
		margin: 0 0 0.9em;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.detail :global(.gloss) {
		margin: 0.7rem 0 0;
		padding-left: 0.75rem;
		border-left: 2px solid var(--border);
		color: rgb(var(--gray));
		font-size: 0.88rem;
		line-height: 1.75;
	}
	.detail :global(.gloss .from) {
		display: block;
		margin-top: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgba(var(--gray), 78%);
	}
	.detail :global(.related-label) {
		margin: 1.1em 0 0.5em;
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: rgb(var(--gray));
	}
	.detail :global(ul) {
		margin: 0;
		padding-left: 1.1em;
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.detail :global(li) {
		margin-bottom: 0.3em;
	}
	.detail :global(li::marker) {
		color: var(--accent);
	}
	.detail :global(ul.chips) {
		padding-left: 0;
	}
	.detail :global(ul.chips li) {
		margin: 0;
	}
	.detail :global(a) {
		text-decoration: none;
		border-bottom: 1px solid rgba(191, 63, 38, 0.45);
	}
	/* 按钮由脚本在选中后重建，它们没有本组件的作用域属性，所以走 global */
	.column :global(.chips) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.column :global(.chips button) {
		font: inherit;
		font-size: 0.84rem;
		padding: 0.2em 0.62em;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: transparent;
		color: rgb(38 36 33);
		cursor: pointer;
		transition:
			background-color 0.25s var(--e-out),
			border-color 0.25s var(--e-out),
			color 0.25s var(--e-out);
	}
	.column :global(.chips button:hover) {
		border-color: var(--accent);
		color: var(--accent-dark);
	}
	.column :global(.chips button[aria-current='true']) {
		background: var(--accent);
		border-color: var(--accent);
		color: #fffdf8;
	}
	.column :global(h2) {
		margin: 2.4em 0 0.9em;
		font-family: var(--font-serif-cjk);
		font-size: 1.25rem;
		color: rgb(var(--black));
	}
	.column :global(h3) {
		margin: 1.8em 0 0.7em;
		font-family: var(--font-serif-cjk);
		font-size: 1rem;
		color: rgb(var(--gray));
	}
	.column :global(h3 a) {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}
	.column :global(h3 a:hover) {
		color: var(--accent);
	}
	/* 还没写笔记的科目不给按钮：图里没有它的点，点了也没反应 */
	.column :global(.empty-chip) {
		display: inline-block;
		padding: 0.2em 0.62em;
		border: 1px dashed var(--border);
		border-radius: 999px;
		font-size: 0.84rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.column :global(.empty-chip:hover) {
		border-color: var(--accent);
		color: var(--accent-dark);
	}
	.column :global(.how) {
		margin-top: 3em;
		padding-top: 1.6em;
		border-top: 1px solid var(--rule);
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.column :global(.how code) {
		font-size: 0.85em;
	}
	.column :global(.how a) {
		color: var(--accent-dark);
	}
	.stage :global(.notice) {
		position: absolute;
		left: 14px;
		bottom: 12px;
		margin: 0;
		font-size: 0.75rem;
		color: rgb(var(--gray));
	}
</style>

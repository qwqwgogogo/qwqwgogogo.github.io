---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/" class="wordmark">
				<i class="dot" aria-hidden="true"></i>{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="social-links">
			<a href="/rss.xml" target="_blank">
				<span class="sr-only">RSS 订阅</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M2.003 2.003a.99.99 0 0 0-.991.994L1 12.99a.991.991 0 0 0 .992.99h1.418A.991.991 0 0 0 4.4 12.99V3.004a.998.998 0 0 0-1.004-1.001H2.003zM5.09 3.004a.991.991 0 0 0-.991.995v8.002c.003.55.448.996.991.99h1.418c.547.005 9.404.005 9.404-4.996 0-5-8.857-4.996-8.857-4.996l-1.965-.001v-.002zm.494 1.496h1.403c0 4.5 4.5 5 4.5 5s.1 3.496-5.903 3.496V4.5z"
					></path>
				</svg>
			</a>
			<a href="https://github.com/qwqwgogogo" target="_blank">
				<span class="sr-only">GitHub 主页</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
	<div class="scroll-progress" aria-hidden="true"><i></i></div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0.2rem 1.25rem;
		background: rgba(10, 12, 17, 62%);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		border-bottom: 1px solid transparent;
		transition:
			padding 0.4s var(--e-out),
			background-color 0.4s var(--e-out),
			border-color 0.4s var(--e-out);
	}
	header.is-scrolled {
		padding: 0.05rem 1.25rem;
		background: rgba(10, 12, 17, 92%);
		border-bottom-color: var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 62px;
		transition: height 0.4s var(--e-out);
	}
	header.is-scrolled nav {
		height: 52px;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0;
		font-weight: 700;
		letter-spacing: -0.02em;
		font-size: 1.12rem;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #67e8f9;
		box-shadow: 0 0 0 0 rgba(103, 232, 249, 55%);
		animation: pulse 2.6s var(--e-io) infinite;
	}
	@keyframes pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(103, 232, 249, 45%);
		}
		45% {
			box-shadow: 0 0 0 7px rgba(103, 232, 249, 0%);
		}
	}
	.internal-links {
		display: flex;
		gap: 0.35rem;
	}
	.social-links {
		display: flex;
		gap: 0.3rem;
	}
	.social-links a {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		color: rgb(var(--gray));
		transition:
			color 0.3s var(--e-out),
			border-color 0.3s var(--e-out),
			transform 0.3s var(--e-out);
	}
	.social-links a:hover {
		color: var(--accent);
		border-color: rgba(165, 180, 252, 45%);
		transform: translateY(-2px);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav {
			height: 56px;
		}
	}
</style>
